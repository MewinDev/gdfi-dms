{
  "name": "gdfi-dms",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "e2e:groups": "tsx scripts/e2e-groups.ts",
    "test:kit-screens": "playwright test -c playwright.kit.config.ts",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:tools": "docker compose --profile tools up -d",
    "db:migrate": "npm run db:deploy",
    "db:deploy": "npm run migrate:check && prisma migrate deploy && npm run migrate:check",
    "migrate:check": "tsx scripts/migrate-check.ts",
    "db:seed": "tsx --require=./scripts/server-only-stub.cjs --env-file-if-exists=.env --env-file-if-exists=.env.local prisma/seed.ts",
    "db:seed:reference": "cross-env SEED_TEST_USERS=false tsx --require=./scripts/server-only-stub.cjs --env-file-if-exists=.env --env-file-if-exists=.env.local prisma/seed.ts",
    "db:reset": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/guard-destructive.ts \"npm run db:reset (drops every table)\" && tsx scripts/migrate-check.ts --folders-only && prisma migrate reset --force && npm run migrate:check",
    "db:studio": "prisma studio",
    "db:create-test": "tsx scripts/db-create-test.ts",
    "docs:permissions": "tsx scripts/docs-permissions.ts",
    "kit:start": "tsx --require=./scripts/server-only-stub.cjs scripts/kit.ts start",
    "kit:reset": "tsx --require=./scripts/server-only-stub.cjs scripts/kit.ts reset",
    "kit:backup": "tsx --require=./scripts/server-only-stub.cjs scripts/kit.ts backup",
    "kit:list": "tsx --require=./scripts/server-only-stub.cjs scripts/kit.ts list",
    "kit:restore": "tsx --require=./scripts/server-only-stub.cjs scripts/kit.ts restore",
    "kit:rebuild": "tsx --require=./scripts/server-only-stub.cjs scripts/kit.ts rebuild",
    "email:reminders": "tsx --require=./scripts/server-only-stub.cjs --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/email.ts reminders",
    "myloans:sync": "tsx --require=./scripts/server-only-stub.cjs --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/myloans-sync.ts",
    "email:test": "tsx --require=./scripts/server-only-stub.cjs --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/email.ts test",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "jose": "^6.2.15",
    "next": "16.4.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cross-env": "^10.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0"
  }
}
