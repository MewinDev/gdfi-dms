# GDFI DMS environment variables. This file holds no real value: names, safe placeholders and notes.
#
# Where values live (see docs/ENVIRONMENT.md):
#   .env          non-secret defaults for a developer PC (safe to share, never production)
#   .env.local    this PC's secrets and switches (never committed); wins over .env
#   production    the hosting provider's Environment Variables screen; no file on any PC
#
# New PC:  Copy-Item .env.example .env   then move the [secret] and [this PC] lines into .env.local.
# Each line says: what it is · secret or not · which environments need it.

# ---------------------------------------------------------------------
# Environment
# ---------------------------------------------------------------------
# local (default), staging or production. production refuses to start on unsafe settings. · not secret · all
APP_ENV=local
# true only on a PC or staging: sample loans, Reset test data, emails go to EMAIL_TEST_RECIPIENT. · not secret · local, staging (must be false in production)
TEST_MODE=false

# ---------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------
# Docker Desktop database user, password and name. Local only (production uses Supabase). · local-only password · local
POSTGRES_USER=gdfi
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=gdfi_dms
# Host port of the Docker database (use 5434 if 5432 and 5433 are taken). · not secret · local
DB_HOST_PORT=5432
# Host port of the optional Adminer page (npm run db:tools). · not secret · local
ADMINER_HOST_PORT=8081
# Connection the app uses. Supabase: the pooled connection (port 6543, ?pgbouncer=true&connection_limit=1&sslmode=require). · secret (has the password) · all
DATABASE_URL="postgresql://gdfi:change-me-local-only@localhost:5432/gdfi_dms?schema=public"
# Connection for migrations (prisma migrate). Supabase: the direct connection (port 5432, ?sslmode=require). Locally the same as DATABASE_URL. · secret · all
DIRECT_URL="postgresql://gdfi:change-me-local-only@localhost:5432/gdfi_dms?schema=public"

# ---------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------
# The app's public address, used for links in emails. https and not localhost in staging and production. · not secret · all
APP_BASE_URL=http://localhost:3001
# Signs the sign-in cookie. A long random string, at least 32 characters. · secret · all
SESSION_SECRET=
# test = test sign-in buttons (now); entra = Microsoft Entra ID (later). · not secret · all
AUTH_MODE=test
# The scheduler sends it in the x-cron-secret header to the two /api/cron endpoints. At least 24 characters in staging and production. · secret · staging, production (optional locally)
CRON_SECRET=

# ---------------------------------------------------------------------
# MyLoans (server only; never NEXT_PUBLIC_)
# ---------------------------------------------------------------------
# mock (sample loans) or live (the MyLoans API). Must be live in production. · not secret · all
MYLOANS_MODE=mock
# MyLoans API address. Replaces the old name MYLOANS_API_BASE_URL (still read, with a warning). · secret · production, and wherever MYLOANS_MODE=live
MYLOANS_BASE_URL=
# MyLoans API key. · secret · production, and wherever MYLOANS_MODE=live
MYLOANS_API_KEY=
# How long to wait for MyLoans before giving up, in milliseconds. · not secret · optional
MYLOANS_TIMEOUT_MS=8000

# ---------------------------------------------------------------------
# Email (Microsoft Graph). Missing values keep emails Not set up; the Email switch in Settings stays off.
# ---------------------------------------------------------------------
# App (client) ID of the Microsoft app with Mail.Send. · secret · staging, production (optional locally)
GRAPH_CLIENT_ID=
# Client secret of that app. · secret · staging, production (optional locally)
GRAPH_CLIENT_SECRET=
# Directory (tenant) ID. · secret · staging, production (optional locally)
GRAPH_TENANT_ID=
# Mailbox the emails are sent from. · not secret · staging, production (optional locally)
GRAPH_SENDER_EMAIL=
# Test mode only: every email goes to this address instead of the real person. Empty: nothing is sent. · not secret · local, staging
EMAIL_TEST_RECIPIENT=
# false = emails are sent only by the scheduled sender, not right after they are queued. Default true. · not secret · optional (the Playwright server uses false)
EMAIL_AUTO_DRAIN=

# ---------------------------------------------------------------------
# File storage
# ---------------------------------------------------------------------
# local (disk) now; supabase is not built yet. · not secret · all
STORAGE_DRIVER=local
# Folder for attachments when STORAGE_DRIVER=local. · not secret · optional
STORAGE_LOCAL_DIR=./storage
# Folder for receipt files. Default: storage/receipts. · not secret · optional
RECEIPTS_DIR=

# ---------------------------------------------------------------------
# Scripts and tests (set on the command line, not in a file)
# ---------------------------------------------------------------------
# npm run db:seed:reference sets it to false: reference data without test users. Refused as true in production. · not secret · scripts
# SEED_TEST_USERS=
# Playwright: test a server that is already running (for example http://localhost:3100). · not secret · tests
# E2E_BASE_URL=
# Playwright: folder for screenshots. · not secret · tests
# SHOTS_DIR=

# ---------------------------------------------------------------------
# Microsoft Entra ID sign-in (later, when AUTH_MODE=entra; not read yet)
# ---------------------------------------------------------------------
# ENTRA_TENANT_ID=
# ENTRA_CLIENT_ID=
# ENTRA_CLIENT_SECRET=
