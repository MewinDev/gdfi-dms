// GDFI DMS - Loan Document Management System
// Standard PostgreSQL only (runs unchanged on local Docker and on Supabase).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Classification {
  FINANCING
  REFINANCING
}

enum FinancingType {
  UNDERTAKING
  NON_UNDERTAKING
}

enum OrcrStatus {
  TRANSFERRED
  UNTRANSFERRED
}

enum MortgageResult {
  MORTGAGE
  NOT_MORTGAGE
  NOT_EVALUATED
}

enum TransactionStatus {
  FOR_CHECKLIST // created, checklist not complete
  READY // checklist complete, waiting for the LA's next action (assign DP / record EDST)
  ASSIGNED // assigned to a DP, waiting for acceptance
  RETURNED // DP declined or returned it; back with the LA
  IN_PROCESS // DP accepted
  FORWARDED // DP forwarded the package to a named LA (in transit to branch)
  COMPLETED
  CANCELLED
}

enum ChecklistKind {
  REQUIRED
  ONE_OF
  OPTIONAL
}

enum Originality {
  ORIGINAL
  COPY
}

/// A per-user permission override (D-008).
enum PermissionEffect {
  GRANT
  DENY
}

/// One override per person and permission key. Effective permissions = the role's ticks + GRANTs - DENYs
/// (lib/auth/build-user.ts). Only people who can manage permissions change them; never their own.
model UserPermissionOverride {
  id      String           @id @default(cuid())
  userId  String
  user    User             @relation("UserOverrides", fields: [userId], references: [id], onDelete: Cascade)
  key     String
  effect  PermissionEffect
  /// Why (shown on the user screen and in the audit log).
  note    String           @default("")
  setById String?
  setBy   User?            @relation("OverrideSetBy", fields: [setById], references: [id])
  setAt   DateTime         @default(now())

  @@unique([userId, key])
  @@index([key])
}

enum BranchAccess {
  ASSIGNED
  ALL
}

enum DefaultOriginality {
  ORIGINAL
  COPY
  EITHER
}

enum DocumentStage {
  EXPECTED // expected from the checklist, not yet physically confirmed
  AT_BRANCH
  IN_TRANSIT
  WITH_DP
  IN_SAFEKEEPING
  PULLED_OUT
  RELEASED
  LOST
  DISPOSED
}

enum DpAssignmentStatus {
  PENDING_ACCEPTANCE
  ACCEPTED
  DECLINED
  WITHDRAWN
  CLOSED
  /// The LA pulled it back before the processor accepted (kept in history, gone from the DP's list).
  PULLED_BACK
}

enum FundStatus {
  NOT_REQUIRED
  FOR_FUNDING
  FUNDED
}

enum ExceptionStatus {
  OPEN
  RESOLVED
}

enum AuditMode {
  AUTOMATIC
  MANUAL
  SIMULATED
}

enum TransmittalStatus {
  DRAFT
  IN_TRANSIT
  RECEIVED
  RECEIVED_WITH_DISCREPANCY
}

enum PullOutStatus {
  REQUESTED
  APPROVED
  DENIED
  RELEASED
  RETURNED
  OVERDUE
  WRITTEN_OFF
}

enum DigitalRecordStatus {
  FOR_SCANNING
  SCANNED
  QC_FAILED
  INDEXED
  UPLOADED
  VERIFIED
}

enum QaFindingStatus {
  OPEN
  ENDORSED
  CORRECTIVE_ACTION
  VALIDATED
  RESOLVED
  CLOSED
}

enum DisposalBatchStatus {
  DRAFT
  FOR_APPROVAL
  APPROVED
  DESTROYED
}

// ---------------------------------------------------------------------------
// Identity and access
// ---------------------------------------------------------------------------

/// Roles live in a table so new roles can be added without code changes.
model Role {
  id              String         @id @default(cuid())
  key             String         @unique // LA, ADMIN, DP, FIN, VAULT, DIG, QA, APPR
  name            String
  description     String         @default("")
  /// Permission keys (see lib/auth/permissions.ts). Server checks read these.
  permissions     String[]
  /// Whether users with this role may sign in yet (built-in roles). Custom roles: see lib/auth/sign-in-rule.ts.
  canSignIn       Boolean        @default(false)
  sortOrder       Int            @default(0)
  /// Seeded roles (names fixed; "Reset to default" restores their permissions). Admin is also locked.
  builtIn         Boolean        @default(false)
  /// Which loan files people with this role see: their assigned branches, or all branches.
  branchAccess    BranchAccess   @default(ASSIGNED)
  /// Inactive instead of delete (only when nobody has the role).
  active          Boolean        @default(true)
  deactivatedAt   DateTime?
  deactivatedById String?
  users           User[]
  approvalBands   ApprovalBand[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

model User {
  id                  String                   @id @default(cuid())
  email               String                   @unique
  name                String
  active              Boolean                  @default(true)
  /// Inactive instead of delete: when and by whom it was made inactive (null while active).
  deactivatedAt       DateTime?
  deactivatedById     String?
  roleId              String
  role                Role                     @relation(fields: [roleId], references: [id])
  /// Identity provider subject (Entra object id) once Microsoft sign-in is enabled.
  externalId          String?                  @unique
  isTestUser          Boolean                  @default(false)
  /// Email me for non-urgent updates (urgent ones always go while emails are on).
  emailNonUrgent      Boolean                  @default(true)
  /// Processors: their own capacity in open jobs (null = the default in Settings, Processor capacity).
  dpCapacity          Int?
  /// Processors: On leave (0% available, shown disabled in the Send panel), optionally until a date.
  dpOnLeave           Boolean                  @default(false)
  /// The last day of the leave, YYYY-MM-DD in Philippine time (null = until switched off).
  dpLeaveUntil        String?
  /// The derived access set (user_branch_access). Empty when allBranches is true.
  branches            UserBranch[]
  /// All branches (no rows in user_branch_access). Admin is always All.
  allBranches         Boolean                  @default(false)
  /// Grants and exceptions (Users, Edit, Branch access).
  accessGrants        UserAccessGrant[]
  /// Per-user permission overrides (D-008): GRANT adds a key the role lacks, DENY removes one it has.
  permissionOverrides UserPermissionOverride[] @relation("UserOverrides")
  overridesSet        UserPermissionOverride[] @relation("OverrideSetBy")
  /// Finance (D-009): which fund types this person handles. The per-type funds keys (view, approve,
  /// release, settle, edit lines, change type, print) count only for a type that is ticked here.
  handlesCa           Boolean                  @default(false)
  handlesFt           Boolean                  @default(false)
  /// Default branch for new work and sending; must be inside the access.
  homeBranchId        String?
  homeBranch          Branch?                  @relation("UserHomeBranch", fields: [homeBranchId], references: [id])
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt

  openedLoans        Loan[]               @relation("LoanOpenedBy")
  notifications      Notification[]
  emails             EmailOutbox[]
  auditLogs          AuditLog[]
  dpAssignments      DpAssignment[]       @relation("DpPrimary")
  secondaryDpWork    DpAssignment[]       @relation("DpSecondary")
  assignmentsMade    DpAssignment[]       @relation("DpAssignedBy")
  receivingAsLa      DpAssignment[]       @relation("DpReceivingLa")
  checklistChecks    ChecklistCheck[]
  cashAdvances       CashAdvance[]        @relation("CaRequestedBy")
  attempts           TransactionAttempt[] @relation("DpAttempts")
  exceptionsRaised   LoanException[]      @relation("ExceptionRaisedBy")
  holdsRaised        Hold[]               @relation("HoldRaisedBy")
  holdsResumed       Hold[]               @relation("HoldResumedBy")
  holdsOwned         Hold[]               @relation("HoldOwner")
  ltoAdvisoriesFiled LtoAdvisory[]        @relation("AdvisoryFiledBy")
  exceptionsResolved LoanException[]      @relation("ExceptionResolvedBy")
  fileAccesses       FileAccessLog[]      @relation("FileAccessBy")
  workItems          WorkItem[]           @relation("WorkItemHolder")
  /// Away (D-046): from / to (YYYY-MM-DD, inclusive). While away the person cannot be named for new work.
  awayFrom           String?
  awayTo             String?
  awayNote           String               @default("")
}

/// Where a record comes from: the MyLoans branch list (code, name, area, division and status are
/// read-only in the DMS), or added by hand in the DMS (fully editable).
enum RecordSource {
  MYLOANS
  DMS
}

/// A MyLoans Division: a business line (Branch Division, Car Financing Division ...), not a region.
/// Filled from the MyLoans branch list; never deleted (inactive instead).
model Division {
  id           String            @id @default(cuid())
  /// The MyLoans division_id (stable). Null for one added by hand or from a list without ids.
  myloansId    Int?              @unique
  code         String?
  name         String
  active       Boolean           @default(true)
  source       RecordSource      @default(DMS)
  lastSyncedAt DateTime?
  branches     Branch[]
  grants       UserAccessGrant[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
}

/// A MyLoans Area (regional: "LUZON 1 (NGMA + RIZAL)", "Luzon 3 - CFD"). The same area id can appear
/// under two divisions in MyLoans, so a branch stores both its division and its area, and the access
/// tree and the Monitoring groups use the pair (Division, Area).
model Area {
  id           String            @id @default(cuid())
  /// The MyLoans area_id (stable). Null for one added by hand or from a list without ids.
  myloansId    Int?              @unique
  code         String?
  name         String
  active       Boolean           @default(true)
  source       RecordSource      @default(DMS)
  lastSyncedAt DateTime?
  branches     Branch[]
  grants       UserAccessGrant[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
}

/// Loans, users and everything else point at a branch by its internal id, never by name or code, so a
/// rename or a code fix never breaks anything. Never deleted: switched off (inactive) or hidden.
model Branch {
  id                String            @id @default(cuid())
  /// MyLoans branch code: exactly 3 digits (100 to 999), unique. Null = "Code needed" (never guessed).
  code              String?           @unique
  /// The code it had before codes became the 3-digit MyLoans codes (for example QC). History only.
  legacyCode        String?
  name              String            @unique
  address           String            @default("")
  active            Boolean           @default(true)
  /// Inactive instead of delete: when and by whom it was made inactive (null while active).
  deactivatedAt     DateTime?
  deactivatedById   String?
  source            RecordSource      @default(DMS)
  /// The MyLoans branch_id (stable). Matching uses it first, the code only when there is no id.
  myloansBranchId   Int?              @unique
  divisionId        String?
  division          Division?         @relation(fields: [divisionId], references: [id])
  areaId            String?
  area              Area?             @relation(fields: [areaId], references: [id])
  /// Hide from DMS (test or retired branches; source:manage): not in pickers, trees, filters or counts,
  /// cannot be chosen for new work, stays on old loans. Survives every import and sync.
  hidden            Boolean           @default(false)
  hiddenAt          DateTime?
  hiddenById        String?
  /// A short note, e.g. "Looks like a test or unused branch".
  note              String            @default("")
  /// MyLoans updated_at when the source gives one; lastSeenAt: when it was last in a MyLoans list.
  myloansUpdatedAt  DateTime?
  lastSeenAt        DateTime?
  lastSyncedAt      DateTime?
  /// Hash of the MyLoans fields as last applied (only differences reach the review).
  syncHash          String?
  users             UserBranch[]
  homeUsers         User[]            @relation("UserHomeBranch")
  grants            UserAccessGrant[]
  reviews           BranchReview[]
  loans             Loan[]
  dpWork            DpAssignment[]
  receivingPackages DpAssignment[]    @relation("DpReceivingBranch")
  cashAdvances      CashAdvance[]
  calendarEntries   HolidayBranch[]
  /// Pre-selected in the Send panel for transactions that need LTO processing (optional).
  usualLtoOfficeId  String?
  usualLtoOffice    LtoOffice?        @relation("BranchUsualLto", fields: [usualLtoOfficeId], references: [id])
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([areaId])
  @@index([divisionId])
}

/// user_branch_access: the DERIVED access set (where a person works), rebuilt from the user's grants
/// and exceptions (lib/branches/access.ts) whenever they change, a branch moves to another area, or a
/// branch, area or division appears. "All branches" is User.allBranches with no rows. Never edited by hand.
model UserBranch {
  userId   String
  branchId String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@id([userId, branchId])
  @@index([branchId])
  @@map("user_branch_access")
}

enum AccessGrantKind {
  DIVISION
  AREA
  BRANCH
}

/// Branch access per user (roles say what a person can do; branch access says where): the union of
/// grants (a whole Division, a whole Area within a Division, or one Branch) minus exceptions (exclude:
/// a branch unticked inside a ticked Area or Division). Area and Division grants are dynamic.
model UserAccessGrant {
  id         String          @id @default(cuid())
  userId     String
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind       AccessGrantKind
  /// DIVISION: the division. AREA: the division of the (Division, Area) pair.
  divisionId String?
  division   Division?       @relation(fields: [divisionId], references: [id])
  areaId     String?
  area       Area?           @relation(fields: [areaId], references: [id])
  branchId   String?
  branch     Branch?         @relation(fields: [branchId], references: [id])
  /// true: an exception (this branch is left out of a ticked Area or Division). BRANCH kind only.
  exclude    Boolean         @default(false)
  createdAt  DateTime        @default(now())

  @@index([userId])
  @@index([areaId])
  @@index([divisionId])
  @@index([branchId])
}

enum BranchReviewKind {
  NEW_BRANCH
  RENAMED
  CODE_CHANGED
  MOVED
  DETAILS_CHANGED
  CLOSED
  REOPENED
  NOT_IN_LIST
  UNKNOWN_CODE
  NEW_AREA
  RENAMED_AREA
  NEW_DIVISION
  RENAMED_DIVISION
}

enum BranchReviewState {
  OPEN
  ACCEPTED
  IGNORED
}

/// A difference between the MyLoans branch list and the DMS copy, waiting for Admin (Accept applies it,
/// Ignore leaves the DMS as it is). Nothing changes silently and nothing is deleted.
model BranchReview {
  id                String            @id @default(cuid())
  kind              BranchReviewKind
  state             BranchReviewState @default(OPEN)
  /// The DMS branch it is about (null for a new branch, area or division).
  branchId          String?
  branch            Branch?           @relation(fields: [branchId], references: [id])
  myloansBranchId   Int?
  myloansAreaId     Int?
  myloansDivisionId Int?
  code              String?
  /// "Antipolo (101)", "Area LUZON 1 (NGMA + RIZAL)".
  title             String
  /// { row: the MyLoans row (normalized), fields: [{ field, label, was, now }] ... }
  payload           Json
  /// file | api | cron | lookup
  source            String
  runId             String?
  /// UNKNOWN_CODE: the PN that showed the code.
  pn                String?
  firstSeenAt       DateTime          @default(now())
  detectedAt        DateTime          @default(now())
  decidedById       String?
  decidedByLabel    String?
  decidedAt         DateTime?
  note              String?

  @@index([state, kind])
  @@index([branchId])
  @@index([myloansBranchId])
}

/// One run of the branch list from MyLoans (file import, API, the daily schedule, an unknown code).
model BranchSyncRun {
  id             String   @id @default(cuid())
  at             DateTime @default(now())
  /// file | api | cron | lookup
  trigger        String
  /// FILE | FULL | INCREMENTAL
  mode           String
  ok             Boolean
  newCount       Int      @default(0)
  changedCount   Int      @default(0)
  unchangedCount Int      @default(0)
  missingCount   Int      @default(0)
  errorCount     Int      @default(0)
  error          String?
  ms             Int      @default(0)
  fileName       String?
  byLabel        String   @default("System")

  @@index([at])
}

// ---------------------------------------------------------------------------
// Reference data (Settings)
// ---------------------------------------------------------------------------

model TransactionType {
  id              String            @id @default(cuid())
  code            String            @unique // NOTARY, EDST, PPSR, MORTGAGE
  name            String
  description     String            @default("")
  requiresDp      Boolean           @default(true)
  /// The processor takes it to an LTO office; the LA must say which office when sending. Only with requiresDp.
  needsLto        Boolean           @default(false)
  /// Owner role of the processing stage for this type (DP, LA ...).
  ownerRole       String            @default("DP")
  sortOrder       Int               @default(0)
  active          Boolean           @default(true)
  /// Inactive instead of delete: when and by whom it was made inactive (null while active).
  deactivatedAt   DateTime?
  deactivatedById String?
  /// The four types the automation rules create (NOTARY, EDST, PPSR, MORTGAGE). Never inactive; code fixed.
  builtIn         Boolean           @default(false)
  rules           ChecklistRule[]
  txns            LoanTransaction[]
  stages          ProcessingStage[]
  caRules         CashAdvanceRule[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
}

model DocumentType {
  id                 String             @id @default(cuid())
  code               String             @unique // ORCR, OR, CR, DS, CHM, DOS, PPSR, INS, ID ...
  name               String
  active             Boolean            @default(true)
  /// Inactive instead of delete: when and by whom it was made inactive (null while active).
  deactivatedAt      DateTime?
  deactivatedById    String?
  /// Default for new checklist items: ORIGINAL, COPY or EITHER.
  defaultOriginality DefaultOriginality @default(EITHER)
  notes              String             @default("")
  rules              ChecklistRule[]
  retentionRule      RetentionRule?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
}

model ChecklistRule {
  id                String           @id @default(cuid())
  transactionTypeId String
  transactionType   TransactionType  @relation(fields: [transactionTypeId], references: [id])
  documentTypeId    String
  documentType      DocumentType     @relation(fields: [documentTypeId], references: [id])
  label             String
  kind              ChecklistKind
  /// Items with kind ONE_OF and the same group: at least one must be ticked.
  oneOfGroup        String?
  /// Must be ticked before the transaction can be sent to a DP. Copied onto each loan file's
  /// checklist line when the loan file is opened (changing it later does not affect open loan files).
  required          Boolean          @default(true)
  /// Belongs to the borrower (valid IDs, SPA): can be copied to a replacement PN. Unit papers never.
  reusable          Boolean          @default(false)
  originality       Originality      @default(ORIGINAL)
  sortOrder         Int              @default(0)
  active            Boolean          @default(true)
  /// Inactive instead of delete: when and by whom it was made inactive (null while active).
  deactivatedAt     DateTime?
  deactivatedById   String?
  checks            ChecklistCheck[]
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
}

model LoanType {
  id              String    @id @default(cuid())
  code            String    @unique // New, Renewal (exact MyLoans values)
  name            String
  description     String    @default("")
  active          Boolean   @default(true)
  /// Inactive instead of delete: when and by whom it was made inactive (null while active).
  deactivatedAt   DateTime?
  deactivatedById String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model LtoOffice {
  id              String    @id @default(cuid())
  code            String    @unique
  name            String
  city            String    @default("")
  active          Boolean   @default(true)
  /// Inactive instead of delete: when and by whom it was made inactive (null while active).
  deactivatedAt   DateTime?
  deactivatedById String?

  /// Optional estimates, used only to help the approver judge the cash advance (transport and time).
  distanceKm              Float?
  travelHours             Float?
  suggestedTransportCents Int?

  assignments      DpAssignment[]
  advisories       LtoAdvisory[]
  usualForBranches Branch[]          @relation("BranchUsualLto")
  advanceLines     CashAdvanceLine[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
}

/// Turnaround time per journey step, in business days. Editable in Settings.
model TatRule {
  id           String   @id @default(cuid())
  key          String   @unique // e.g. P3_CHECKLIST, P4_NOTARY
  phase        Int
  step         String
  label        String
  businessDays Int
  /// Free-text target shown when the TAT is not a whole number of days (e.g. "Seconds", "Per Finance policy").
  note         String   @default("")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model CashAdvanceRule {
  id                String          @id @default(cuid())
  transactionTypeId String
  transactionType   TransactionType @relation(fields: [transactionTypeId], references: [id])
  /// Expense kind this rule is for (one rule per transaction type and kind): the kind's code
  /// (Settings > Expense kinds). An OTHER rule also applies to any kind without its own rule.
  kind              String          @default("OTHER")
  kindRef           ExpenseKind     @relation(fields: [kind], references: [code], onUpdate: Cascade)
  purpose           String
  /// Suggested amount; empty when the owner has not set one.
  suggestedAmount   Decimal?        @db.Decimal(14, 2)
  /// Maximum per transaction (more needs a typed reason).
  maxAmount         Decimal         @db.Decimal(14, 2)
  /// Business days after release within which the DP must liquidate.
  active            Boolean         @default(true)
  /// Inactive instead of delete: when and by whom it was made inactive (null while active).
  deactivatedAt     DateTime?
  deactivatedById   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// The working-days calendar (D-018, D-041): holidays and office closures. A non-working day for every branch
/// (allBranches) or for the ticked branches (HolidayBranch). Several rows may share a date (a holiday and a
/// closure, or closures of different branches).
model HolidayCalendar {
  id              String            @id @default(cuid())
  date            String // YYYY-MM-DD (business time zone)
  name            String
  /// HOLIDAY (Settings, Holidays) or CLOSURE (an office closure: typhoon, sudden declaration; with a reason).
  kind            CalendarEntryKind @default(HOLIDAY)
  type            HolidayType       @default(REGULAR)
  /// All branches, or only the ticked branches (HolidayBranch).
  allBranches     Boolean           @default(true)
  branches        HolidayBranch[]
  /// Required for a closure and for a back-dated entry.
  reason          String            @default("")
  /// Seeded sample, not an official date ("Sample. Enter the official list from the government proclamation.").
  isSample        Boolean           @default(false)
  createdById     String?
  /// Inactive: no longer skipped when counting working days.
  active          Boolean           @default(true)
  /// Inactive instead of delete: when and by whom it was made inactive (null while active).
  deactivatedAt   DateTime?
  deactivatedById String?
  createdAt       DateTime          @default(now())

  @@index([date])
}

enum CalendarEntryKind {
  HOLIDAY
  CLOSURE
}

enum HolidayType {
  REGULAR
  SPECIAL_NON_WORKING
  LOCAL
}

/// The branches of a holiday or closure that is not for all branches.
model HolidayBranch {
  holidayId String
  holiday   HolidayCalendar @relation(fields: [holidayId], references: [id], onDelete: Cascade)
  branchId  String
  branch    Branch          @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@id([holidayId, branchId])
  @@index([branchId])
}

/// A saved due date moved (D-041): a holiday or closure added inside its counting window, a hold that paused
/// the clock, or an admin correction. Append-only history; the record keeps only its current due date.
/// Piece 9 (D-014, D-015, D-046): one hand-off of work, its round and its clock. Every hand-off is an item: the LA's
/// work on a transaction, a DP job, a funds request for Finance, a package for the receiving LA, and (from the
/// sync, later) a loan released but not yet in the DMS. One row per round: a return, a move or a re-send opens the
/// next round. History is in WorkMovement.
model WorkItem {
  id             String         @id @default(cuid())
  /// TRANSACTION (LA work), DP_JOB, FUND_REQUEST, PACKAGE, LOAN_CANDIDATE.
  kind           String
  /// The transaction (TRANSACTION, DP_JOB), the cash advance (FUND_REQUEST), the job (PACKAGE), or the PN (LOAN_CANDIDATE).
  subjectId      String
  round          Int            @default(1)
  /// LA, DP or FIN: who can take it from the pool.
  role           String
  /// The branch of the pool and of the calendar that counts it (D-041).
  branchId       String
  /// Narrows a pool (for example a funds type code for Finance).
  poolKey        String         @default("")
  loanId         String?
  pn             String?
  label          String         @default("")
  /// POOL (nobody yet), INBOX (named, not accepted), HELD (accepted), DONE.
  state          String
  holderUserId   String?
  holder         User?          @relation("WorkItemHolder", fields: [holderUserId], references: [id])
  arrivedAt      DateTime       @default(now())
  acceptedAt     DateTime?
  /// This round's due date (YYYY-MM-DD) and target; the overall due date carries over a move unchanged.
  dueDate        String?
  targetDays     Int?
  overallDueDate String?
  /// TAT (accept to forward) or WAITING (arrival to the action, for "counts as accept" steps).
  measure        String         @default("TAT")
  /// FORWARDED, RETURNED, DONE, MOVED_AWAY, BACK_TO_POOL, CANCELLED, PULLED_BACK.
  outcome        String?
  doneAt         DateTime?
  returnReason   String         @default("")
  /// Made from older records with a time missing: left out of TAT performance reports.
  migrated       Boolean        @default(false)
  /// A DP job sent to the Branch DP pool: the send details, used when a processor accepts it.
  sendInput      Json?
  createdAt      DateTime       @default(now())
  movements      WorkMovement[]

  @@unique([kind, subjectId, round])
  @@index([state, branchId, role])
  @@index([holderUserId, state])
  @@index([loanId])
}

/// The append-only history of a work item: arrive, accept, forward, return, move, back to the pool, cancel.
model WorkMovement {
  id          String   @id @default(cuid())
  workItemId  String
  workItem    WorkItem @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  action      String
  fromUserId  String?
  toUserId    String?
  byId        String?
  byLabel     String   @default("")
  at          DateTime @default(now())
  remarks     String   @default("")
  waitingDays Int?
  tatDaysUsed Int?
  isLate      Boolean?

  @@index([workItemId])
  @@index([at])
}

model DueDateChange {
  id               String   @id @default(cuid())
  /// "DpAssignment" (a DP job's TAT) or "CashAdvance" (the liquidation due date).
  subjectType      String
  subjectId        String
  loanId           String?
  pn               String?
  fromDate         String // YYYY-MM-DD
  toDate           String
  /// HOLIDAY, CLOSURE, HOLD_PAUSE or CORRECTION.
  cause            String
  calendarEntryId  String?
  /// The change this one undoes (a holiday or closure made inactive gives back only its own extension, D-042).
  reversesChangeId String?
  /// Was the item overdue before this change (shown in the preview, "M currently overdue").
  wasOverdue       Boolean  @default(false)
  note             String   @default("")
  byId             String?
  byLabel          String   @default("")
  at               DateTime @default(now())

  @@index([subjectType, subjectId])
  @@index([at])
}

/// Key/value system settings (toggles such as "simulate MyLoans unavailable").
model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Loan File
// ---------------------------------------------------------------------------

/// The Loan File. Keyed by PN. Created only by "Open Loan File".
model Loan {
  id                  String   @id @default(cuid())
  pn                  String   @unique
  cin                 String?
  cif                 String?
  sourceLoanId        String?
  borrowerName        String
  branchId            String
  branch              Branch   @relation(fields: [branchId], references: [id])
  loanType            String
  productName         String   @default("")
  totalReleasedAmount Decimal  @db.Decimal(14, 2)
  releasedAt          DateTime
  sourceStatus        String

  /// The account details as MyLoans gave them when the file was opened (docs/myloans/field-map.md); minor
  /// changes (area, division, company) update them, the rest change only when Admin applies a review.
  /// Kept as text, exactly as given. Never used for access: branchId above (the DMS branch) is.
  source             String    @default("MyLoans")
  productCode        String?
  sourceBranchCode   String?
  sourceBranchName   String?
  sourceAreaId       String?
  sourceAreaName     String?
  sourceDivisionId   String?
  sourceDivisionName String?
  sourceCompanyId    String?
  sourceCompanyName  String?
  /// MyLoans TransactionStatusId and its name ("Loan Released" for 12).
  sourceStatusId     String?
  sourceStatusName   String?
  /// MyLoans TransactionIsActive.
  sourceIsActive     Boolean?
  /// MyLoans SourceUpdatedAt: the latest update of any part of the loan there.
  sourceUpdatedAt    DateTime?

  retrievedAt DateTime
  openedAt    DateTime @default(now())
  openedById  String
  openedBy    User     @relation("LoanOpenedBy", fields: [openedById], references: [id])

  classification      Classification
  /// D-031: no keyword matched when it was classified (the "Classified by default" label and filter). Never blocks.
  classifiedByDefault Boolean         @default(false)
  /// D-031: what the keyword rules say now when it differs from the saved classification ("Classification
  /// changed since accepted"); null when they agree. Changed only by Reclassify (loans:reclassify).
  classificationNow   Classification?
  financingType       FinancingType?
  orcrStatus          OrcrStatus?
  mortgageResult      MortgageResult
  ruleFired           String
  /// True when an Admin (Supervisor) overrode the automatic result.
  overridden          Boolean         @default(false)

  /// Derived from the transactions on every write (never typed in). Cached for list filters.
  stage      String   @default("Opened")
  stageSince DateTime @default(now())

  /// False when the last refresh from MyLoans failed (stored copy shown as Not current).
  sourceCurrent       Boolean   @default(true)
  lastRefreshError    String?
  /// When MyLoans was last asked (answered or not). retrievedAt is the last answer.
  lastCheckedAt       DateTime?
  /// MyLoans polling: A work in progress, B not yet sent, C finished steps not closed; null = never (closed, cancelled).
  syncTier            String?
  /// When the background sync should ask MyLoans again (partial index "Loan_due_idx" on active loans).
  nextCheckAt         DateTime?
  /// Replacement PN links (a changed unit gets a new PN: a new loan file linked to the old one).
  replacesPn          String?
  replacedByPn        String?
  /// How the replacement was confirmed (no payment on the old PN): MyLoans evidence, the Admin's tick, or an override note.
  replacementEvidence String?
  /// Closed as cancelled in MyLoans (Admin review): when and why ("Cancelled in MyLoans", "Replaced by PN-...").
  cancelledAt         DateTime?
  cancelReason        String?

  closedAt   DateTime?
  archivedAt DateTime?
  disposedAt DateTime?

  snapshots        LoanSourceSnapshot[]
  sourceChanges    SourceChange[]
  transactions     LoanTransaction[]
  /// D-050: every myloans copy this loan file was read from (one row per ExternalLoanId; piece 7 adds redo copies).
  sourceIdentities LoanSourceIdentity[]
  documents        DocumentItem[]
  dpAssignments    DpAssignment[]
  problems         Problem[]
  holds            Hold[]
  exceptions       LoanException[]
  transmittalItems TransmittalItem[]
  pullOuts         PullOutRequest[]
  digitalRecords   DigitalRecord[]
  qaFindings       QaFinding[]
  notifications    Notification[]
  attachments      Attachment[]
  auditLogs        AuditLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// D-050: myloans' transaction id (ExternalLoanId) and the contract hash, saved when the loan file is opened.
  externalLoanId      Int?     @unique
  contentHash         String?

  @@index([branchId, stage])
  @@index([cin])
  @@index([cif])
  @@index([lastCheckedAt])
}

/// Full MyLoans API response for every retrieval.
model LoanSourceSnapshot {
  id          String   @id @default(cuid())
  loanId      String
  loan        Loan     @relation(fields: [loanId], references: [id], onDelete: Cascade)
  retrievedAt DateTime @default(now())
  adapter     String // mock | live
  /// Where the copy came from (one source today). The full answer is in payload; the compared fields in tracked.
  source      String   @default("MyLoans")
  payload     Json
  /// Field-level differences against the previous snapshot (null for the first).
  changes     Json?
  /// The tracked fields as stored values (lib/myloans/changes.ts) and their hash. Null on older rows.
  tracked     Json?
  hash        String?
  /// BASE (first copy), MINOR (only the latest is kept), MATERIAL, STATUS, REPLACEMENT (always kept).
  kind        String?

  @@index([loanId, retrievedAt])
}

enum SourceChangeCategory {
  MATERIAL
  STATUS
  REPLACEMENT
  /// Borrower details (name, address, contact number, CIF, CIN): decided by the branch supervisors and
  /// approvers (myloans:review_borrower), apart from the Admin item. One open item of each per loan.
  BORROWER
}

enum SourceChangeState {
  OPEN
  APPLIED
  KEPT
  CLOSED_CANCELLED
}

/// A MyLoans change that needs a decision (Admin review). Append-only except the decision fields
/// (state, decidedById, decidedByLabel, decidedAt, note) and, while Open, the latest detection
/// (changes, proposed, detectedAt) whose earlier versions are kept in history.
model SourceChange {
  id             String               @id @default(cuid())
  loanId         String
  loan           Loan                 @relation(fields: [loanId], references: [id], onDelete: Cascade)
  firstSeenAt    DateTime             @default(now())
  detectedAt     DateTime             @default(now())
  category       SourceChangeCategory
  /// [{ field, label, was, now, kind }] (stored values, amounts in centavos).
  changes        Json
  /// The proposed effect: what the rules would do on the new data (nothing saved).
  proposed       Json
  /// Earlier detections while it was open: [{ detectedAt, category, changes }].
  history        Json                 @default("[]")
  /// The new values' hash (the snapshot it was detected on).
  hash           String
  /// Possible replacement PNs (same CIN or CIF), or the PN MyLoans named.
  candidates     String[]             @default([])
  state          SourceChangeState    @default(OPEN)
  decidedById    String?
  decidedByLabel String?
  decidedAt      DateTime?
  note           String?
  simulated      Boolean              @default(false)

  @@index([loanId, state])
  @@index([state])
}

model LoanTransaction {
  id               String               @id @default(cuid())
  loanId           String
  loan             Loan                 @relation(fields: [loanId], references: [id], onDelete: Cascade)
  typeId           String
  type             TransactionType      @relation(fields: [typeId], references: [id])
  status           TransactionStatus    @default(FOR_CHECKLIST)
  statusSince      DateTime             @default(now())
  /// AUTOMATIC (rule engine) or OVERRIDE (Supervisor).
  origin           String               @default("AUTOMATIC")
  checklistSavedAt DateTime?
  edstReference    String?
  completedAt      DateTime?
  cancelledAt      DateTime?
  cancelReason     String?
  checks           ChecklistCheck[]
  documents        DocumentItem[]
  dpAssignments    DpAssignment[]
  /// LA flag: does this transaction need funds? (no amount; the DP asks Finance for it)
  fundsNeeded      FundsNeeded          @default(UNANSWERED)
  /// Codes of the expense kinds the LA flagged (Settings > Expense kinds).
  fundsKinds       String[]
  /// Free text kept from older data (e.g. the old cash advance amount).
  fundsNote        String               @default("")
  fundsFlaggedAt   DateTime?
  advanceLines     CashAdvanceLine[]
  attempts         TransactionAttempt[]
  problems         Problem[]
  holds            Hold[]
  exceptions       LoanException[]
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@index([loanId, status])
}

model ChecklistCheck {
  id               String              @id @default(cuid())
  transactionId    String
  transaction      LoanTransaction     @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  ruleId           String?
  rule             ChecklistRule?      @relation(fields: [ruleId], references: [id])
  /// For "Others" free-text items.
  otherLabel       String?
  /// Copy of the rule's "required" flag when the loan file was opened.
  required         Boolean             @default(true)
  checked          Boolean             @default(false)
  checkedAt        DateTime?
  checkedById      String?
  checkedBy        User?               @relation(fields: [checkedById], references: [id])
  /// Optional papers only: the LA ticked "Include in this file" (then it is expected like a required paper).
  /// Off: the paper is ignored (DP does not expect it, cannot return the file for it, needs no remarks).
  includedInFile   Boolean             @default(false)
  /// Missing papers (lib/services/papers.ts). Null: Present (checked) or not answered yet (unchecked).
  /// MISSING: not in hand (checked is false); RECEIVED_LATE: it arrived later (checked is true).
  /// A CHECK constraint (migration 20261119090009_missing_papers) keeps it consistent with checked.
  missingState     PaperMissingState?
  missingReasonId  String?
  missingReason    MissingPaperReason? @relation(fields: [missingReasonId], references: [id])
  /// 5 to 500 characters once saved (null until the LA saves them: Send stays blocked).
  missingRemarks   String?
  missingAt        DateTime?
  missingById      String?
  missingByLabel   String?
  /// Last time the reason and remarks were saved.
  remarksAt        DateTime?
  /// Received late: the date it arrived (YYYY-MM-DD, Philippine time), and who recorded it, when.
  receivedLateOn   String?
  receivedLateAt   DateTime?
  receivedLateById String?
  receivedLateBy   String?
  paperEvents      PaperEvent[]
  documentItem     DocumentItem?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@unique([transactionId, ruleId])
  @@index([missingState])
}

model DocumentItem {
  id               String             @id @default(cuid())
  /// {PN}-{DocTypeCode}-{Seq}. Null until the LA confirms the item is physically present.
  documentId       String?            @unique
  loanId           String
  loan             Loan               @relation(fields: [loanId], references: [id], onDelete: Cascade)
  transactionId    String?
  transaction      LoanTransaction?   @relation(fields: [transactionId], references: [id])
  checkId          String?            @unique
  check            ChecklistCheck?    @relation(fields: [checkId], references: [id])
  docTypeCode      String
  label            String
  originality      Originality        @default(ORIGINAL)
  stage            DocumentStage      @default(EXPECTED)
  /// Exactly one custodian at a time.
  custodianLabel   String             @default("Not yet received")
  custodianRole    String?
  custodianUserId  String?
  location         String             @default("")
  since            DateTime           @default(now())
  movements        DocumentMovement[]
  digitalRecords   DigitalRecord[]
  transmittalItems TransmittalItem[]
  pullOuts         PullOutRequest[]
  vaultLocationId  String?
  vaultLocation    VaultLocation?     @relation(fields: [vaultLocationId], references: [id])
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@index([loanId])
}

/// Append-only custody trail. Never updated or deleted; corrections reference the corrected row.
model DocumentMovement {
  id               String             @id @default(cuid())
  documentItemId   String
  documentItem     DocumentItem       @relation(fields: [documentItemId], references: [id], onDelete: Cascade)
  action           String // RECEIVED_AT_BRANCH, DISPATCHED_TO_DP, ACKNOWLEDGED_BY_DP, ...
  fromCustodian    String?
  toCustodian      String?
  purpose          String?
  remarks          String?
  createdAt        DateTime           @default(now())
  actorId          String?
  /// Who did it, as shown (the name at the time; "Name (Simulated)" for the test simulator).
  actorLabel       String?
  /// Where the paper is after this movement (branch, "With DP ...", "In transit to ...", vault slot).
  location         String?
  acknowledgedAt   DateTime?
  acknowledgedById String?
  correctsId       String?
  corrects         DocumentMovement?  @relation("MovementCorrection", fields: [correctsId], references: [id])
  correctedBy      DocumentMovement[] @relation("MovementCorrection")
  simulated        Boolean            @default(false)

  @@index([documentItemId, createdAt])
}

// ---------------------------------------------------------------------------
// Phase 3 / 4: DP assignment, cash advance
// ---------------------------------------------------------------------------

model DpAssignment {
  id                  String             @id @default(cuid())
  loanId              String
  loan                Loan               @relation(fields: [loanId], references: [id], onDelete: Cascade)
  transactionId       String
  transaction         LoanTransaction    @relation(fields: [transactionId], references: [id])
  dpBranchId          String
  dpBranch            Branch             @relation(fields: [dpBranchId], references: [id])
  dpUserId            String
  dpUser              User               @relation("DpPrimary", fields: [dpUserId], references: [id])
  /// Pasuyo (secondary DP)
  secondaryDpUserId   String?
  secondaryDpUser     User?              @relation("DpSecondary", fields: [secondaryDpUserId], references: [id])
  pasuyoReason        String?
  pasuyoEvents        PasuyoEvent[]
  /// Job stages (snapshot of the type's processing stages, made when the first stage starts).
  stages              JobStage[]
  ltoOfficeId         String?
  ltoOffice           LtoOffice?         @relation(fields: [ltoOfficeId], references: [id])
  /// Old per-assignment fund status (kept for history). Funds now follow the transaction flag and its advance lines.
  fundStatus          FundStatus         @default(NOT_REQUIRED)
  returnedAt          DateTime?
  returnReasons       String?
  /// Return to LA (after accepting): why papers are needed (Settings list). Null for a decline or an older return.
  returnReasonId      String?
  returnReason        ReturnReason?      @relation(fields: [returnReasonId], references: [id])
  beyondTatReason     String?
  recommendedDpUserId String?
  status              DpAssignmentStatus @default(PENDING_ACCEPTANCE)
  endorsedAt          DateTime           @default(now())
  assignedById        String
  assignedBy          User               @relation("DpAssignedBy", fields: [assignedById], references: [id])
  decidedAt           DateTime?
  declineReasons      String?
  /// Phase 4 processing details (notary, PPSR, LTO), recorded by the DP later.
  processing          Json?
  forwardedAt         DateTime?
  receivingLaId       String?
  /// TAT saved at accept (D-041): the due date (YYYY-MM-DD, Manila), the target and whose calendar counts it
  /// (the processor's branch). Moved only by a logged DueDateChange.
  dueDate             String?
  targetDays          Int?
  dueBranchId         String?
  receivingLa         User?              @relation("DpReceivingLa", fields: [receivingLaId], references: [id])
  /// The branch the DP chose when forwarding (the loan's branch is only a hint).
  receivingBranchId   String?
  receivingBranch     Branch?            @relation("DpReceivingBranch", fields: [receivingBranchId], references: [id])
  closedAt            DateTime?
  /// Return to LA: when the DP handed the papers received at Accept back to the LA.
  papersHandedAt      DateTime?
  /// When the LA confirmed the papers back, and who (send again stays blocked until then).
  papersReceivedAt    DateTime?
  papersReceivedBy    String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@index([dpUserId, status])
  @@index([loanId])
  @@index([status, endorsedAt])
  @@index([decidedAt])
  @@index([returnedAt])
}

model LoanException {
  id              String           @id @default(cuid())
  loanId          String
  loan            Loan             @relation(fields: [loanId], references: [id], onDelete: Cascade)
  transactionId   String?
  transaction     LoanTransaction? @relation(fields: [transactionId], references: [id])
  /// LEGAL_DOCS_COMPLETION, NO_FUNDS, SOURCE_CHANGE, DP_DECLINED, LTO_PROBLEM, INCOMPLETE_PACKAGE, ...
  type            String
  reason          String
  details         Json?
  status          ExceptionStatus  @default(OPEN)
  raisedAt        DateTime         @default(now())
  raisedById      String?
  raisedBy        User?            @relation("ExceptionRaisedBy", fields: [raisedById], references: [id])
  /// "System" when raised automatically.
  raisedByLabel   String
  resolvedAt      DateTime?
  resolvedById    String?
  resolvedBy      User?            @relation("ExceptionResolvedBy", fields: [resolvedById], references: [id])
  resolvedByLabel String?
  resolution      String?
  simulated       Boolean          @default(false)

  @@index([loanId, status])
}

// ---------------------------------------------------------------------------
// Phase 6: transmittal and vault
// ---------------------------------------------------------------------------

model Transmittal {
  id           String            @id @default(cuid())
  number       String            @unique
  fromBranchId String?
  toLabel      String            @default("Main Vault")
  method       String // HAND_CARRY, COURIER, POUCH
  status       TransmittalStatus @default(DRAFT)
  createdById  String?
  dispatchedAt DateTime?
  receivedAt   DateTime?
  receivedBy   String?
  simulated    Boolean           @default(false)
  items        TransmittalItem[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
}

model TransmittalItem {
  id             String       @id @default(cuid())
  transmittalId  String
  transmittal    Transmittal  @relation(fields: [transmittalId], references: [id], onDelete: Cascade)
  loanId         String
  loan           Loan         @relation(fields: [loanId], references: [id])
  documentItemId String
  documentItem   DocumentItem @relation(fields: [documentItemId], references: [id])
  received       Boolean      @default(false)
  discrepancy    String?

  @@unique([transmittalId, documentItemId])
}

model VaultLocation {
  id        String         @id @default(cuid())
  vault     String
  rack      String
  shelf     String
  box       String
  slot      String
  label     String         @unique
  occupied  Boolean        @default(false)
  documents DocumentItem[]
  createdAt DateTime       @default(now())
}

// ---------------------------------------------------------------------------
// Phase 8: pull-out
// ---------------------------------------------------------------------------

model PullOutRequest {
  id                 String        @id @default(cuid())
  loanId             String
  loan               Loan          @relation(fields: [loanId], references: [id])
  documentItemId     String
  documentItem       DocumentItem  @relation(fields: [documentItemId], references: [id])
  requestedById      String?
  purpose            String
  isThirdParty       Boolean       @default(false)
  thirdPartyId       String?
  thirdParty         ThirdParty?   @relation(fields: [thirdPartyId], references: [id])
  expectedReturnDate DateTime
  status             PullOutStatus @default(REQUESTED)
  approvals          Json?
  releasedAt         DateTime?
  returnedAt         DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
}

model ThirdParty {
  id                  String           @id @default(cuid())
  name                String
  organization        String           @default("")
  idType              String           @default("")
  idNumber            String           @default("")
  authorizationLetter String?
  requests            PullOutRequest[]
  createdAt           DateTime         @default(now())
}

// ---------------------------------------------------------------------------
// Phase 7: DigiCur, Phase 9: QA, Phase 10: retention
// ---------------------------------------------------------------------------

model DigitalRecord {
  id             String              @id @default(cuid())
  loanId         String
  loan           Loan                @relation(fields: [loanId], references: [id], onDelete: Cascade)
  documentItemId String
  documentItem   DocumentItem        @relation(fields: [documentItemId], references: [id])
  status         DigitalRecordStatus @default(FOR_SCANNING)
  pageCount      Int?
  rescanReason   String?
  storageKey     String?
  verifiedAt     DateTime?
  verifiedBy     String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
}

model QaFinding {
  id          String          @id @default(cuid())
  loanId      String
  loan        Loan            @relation(fields: [loanId], references: [id])
  category    String
  severity    String // LOW, MEDIUM, HIGH, CRITICAL
  department  String
  demerits    Int
  isRepeat    Boolean         @default(false)
  dueDate     DateTime
  description String
  status      QaFindingStatus @default(OPEN)
  raisedBy    String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model RetentionRule {
  id             String       @id @default(cuid())
  documentTypeId String       @unique
  documentType   DocumentType @relation(fields: [documentTypeId], references: [id])
  retentionYears Int
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model DisposalBatch {
  id          String              @id @default(cuid())
  month       String // YYYY-MM
  status      DisposalBatchStatus @default(DRAFT)
  approvedBy  String?
  approvedAt  DateTime?
  certificate String?
  loanIds     String[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
}

model Attachment {
  id          String   @id @default(cuid())
  loanId      String?
  loan        Loan?    @relation(fields: [loanId], references: [id])
  ownerType   String // e.g. DocumentItem, CashAdvanceLiquidation, DisposalBatch
  ownerId     String
  fileName    String
  contentType String
  sizeBytes   Int
  storageKey  String
  uploadedBy  String?
  createdAt   DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Notifications and audit
// ---------------------------------------------------------------------------

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  loanId    String?
  loan      Loan?     @relation(fields: [loanId], references: [id], onDelete: Cascade)
  title     String
  body      String
  link      String?
  readAt    DateTime?
  emailedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
}

enum EmailStatus {
  QUEUED
  SENT
  FAILED
  SKIPPED
}

/// Email channel of the notifications. Written in the same database transaction as the notification;
/// append-only except the status fields (status, attempts, lastError, nextAttemptAt, sentAt, batchedIntoId).
/// Never holds a secret or a token.
model EmailOutbox {
  id              String      @id @default(cuid())
  event           String
  userId          String?
  user            User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  /// "Joy Navarro (DP)"
  toName          String
  /// The real person's address; toAddress is where it goes (the test address in test mode).
  intendedAddress String
  toAddress       String?
  subject         String
  html            String
  text            String
  /// The headline of this one item, used when several are combined into one email.
  headline        String
  link            String?
  urgent          Boolean     @default(false)
  status          EmailStatus
  attempts        Int         @default(0)
  lastError       String?
  nextAttemptAt   DateTime?
  /// When batched: the row whose email carried this one.
  batchedIntoId   String?
  /// Reminders: one per thing per day.
  dedupeKey       String?     @unique
  loanId          String?
  transactionId   String?
  simulated       Boolean     @default(false)
  createdAt       DateTime    @default(now())
  sentAt          DateTime?

  @@index([status, nextAttemptAt])
  @@index([createdAt])
  @@index([event, userId, status])
}

/// Append-only audit trail. Written in the same database transaction as the change it records.
model AuditLog {
  id          String    @id @default(cuid())
  at          DateTime  @default(now())
  actorId     String?
  actor       User?     @relation(fields: [actorId], references: [id])
  /// Display name at the time ("System" for automatic entries).
  actorLabel  String
  mode        AuditMode
  action      String
  entityType  String
  entityId    String?
  loanId      String?
  loan        Loan?     @relation(fields: [loanId], references: [id], onDelete: SetNull)
  pn          String?
  /// Journey step id this entry completes (e.g. "1.4", "3.6").
  journeyStep String?
  summary     String
  before      Json?
  after       Json?
  details     Json?

  @@index([pn])
  @@index([loanId, at])
  @@index([action])
  @@index([at])
}

// ---------------------------------------------------------------------------
// Funds (cash advance), DP attempts, receipts and problems
// Money is stored as integer centavos (Int). Never floats.
// Released amounts, attempts, receipts and returns are append-only: a correction is a new row
// that references the old one (correctsId).
// ---------------------------------------------------------------------------

enum FundsNeeded {
  UNANSWERED
  YES
  NO
}

/// How the amount field starts when a kind is picked (Settings > Expense kinds).
enum ExpenseAmountMode {
  /// Person enters it (the default; always for Other).
  TYPED
  /// Pre-filled with the kind's amount; the person may change it.
  SUGGESTED
  /// Pre-filled and cannot be changed by the processor (set fees only).
  FIXED
}

/// What a cash advance or fund transfer line can be for. Nothing is deleted: a kind is made inactive.
/// OTHER is built in: never renamed, never inactive, always last, and its lines say what they are.
model ExpenseKind {
  id              String            @id @default(cuid())
  /// Stable code kept on rules and lines (NOTARY_FEE, PPSR_FEE, LTO_FEE, TRANSPORT, OTHER, or made from the name).
  code            String            @unique
  name            String
  /// The name in lower case without spaces: names are unique ignoring case and spaces.
  nameKey         String            @unique
  /// Only OTHER: fixed, cannot be renamed or made inactive.
  builtIn         Boolean           @default(false)
  sortOrder       Int               @default(0)
  amountMode      ExpenseAmountMode @default(TYPED)
  /// The kind's own amount (Suggested or Fixed); null for "Person enters it".
  amountCents     Int?
  active          Boolean           @default(true)
  deactivatedAt   DateTime?
  deactivatedById String?
  rules           CashAdvanceRule[]
  lines           CashAdvanceLine[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
}

enum AdvanceStatus {
  REQUESTED
  APPROVED
  RELEASED
  FOR_LIQUIDATION
  PARTIALLY_LIQUIDATED
  LIQUIDATED
  CLOSED
  DENIED
  CANCELLED
}

enum AttemptResult {
  DONE
  NOT_PROCESSED
}

enum RestDecision {
  CARRY_OVER
  RETURN
  NONE
}

enum TopUpStatus {
  REQUESTED
  APPROVED
  DENIED
}

enum CarryOverStatus {
  AUTO
  PENDING
  APPROVED
  DENIED
}

/// One cash advance requested by a DP, covering several flagged transactions (and other expenses).
model CashAdvance {
  id                   String            @id @default(cuid())
  /// Move to the new PN: the line whose balance this request moves (the cash is already with the DP).
  movedFromLineId      String?
  number               String            @unique // CA-2026-0001 (Cash advance), FT-2026-0001 (Fund transfer): the type's code, the year, its own running number
  /// The numbers it had before (a fund transfer once numbered CA-, or a type change): "Formerly CA-2026-0008"; search finds them.
  formerNumbers        String[]          @default([])
  requestedById        String
  requestedBy          User              @relation("CaRequestedBy", fields: [requestedById], references: [id])
  branchId             String
  branch               Branch            @relation(fields: [branchId], references: [id])
  status               AdvanceStatus     @default(REQUESTED)
  requestedCents       Int
  /// Notes such as a Pasuyo handover ("₱500.00 handed to Grace Tan, CA-2026-0003").
  note                 String            @default("")
  approvedCents        Int?
  releasedCents        Int               @default(0)
  approvedById         String?
  approvedAt           DateTime?
  approvalNote         String            @default("")
  deniedReason         String            @default("")
  releasedById         String?
  releasedAt           DateTime?
  releaseRef           String            @default("")
  /// Funds type (Settings > Funds types): the id, and a copy of its code and name at request time
  /// (or when Finance changed it), so a rename never changes old records.
  fundsTypeId          String            @default("fundstype_ca")
  fundsType            FundsType         @relation(fields: [fundsTypeId], references: [id])
  fundsTypeCode        String            @default("CA")
  fundsTypeName        String            @default("Cash advance")
  /// Release details for a type that needs them (a fund transfer): the transfer date and the receiving
  /// account. Only the last 4 digits of the account number are ever stored.
  transferDate         String            @default("")
  accountProvider      String            @default("")
  accountName          String            @default("")
  accountLast4         String            @default("")
  /// Restarts at each carry-over decision.
  liquidationDueAt     DateTime?
  /// The start of the liquidation count (YYYY-MM-DD): the release or the latest carry-over decision (D-041 window).
  liquidationDueFrom   String?
  /// What the due date counts from (D-044): LTO (last pickup), CANCELLED, RELEASE (note-only lines) or FALLBACK
  /// (the LTO is not done after its job's TAT due date). Null: not set yet, or an older advance.
  liquidationBasis     String?
  /// Pickups count from here (a carry-over restarts the wait for that attempt's LTO pickup).
  liquidationCountFrom DateTime?
  /// While there is no date: what it waits for, in words ("1 of 3 left").
  liquidationNote      String            @default("")
  /// Finance and the LA Supervisor/Head were told that the fallback applies (once).
  fallbackNotifiedAt   DateTime?
  /// The late record (D-044): when it was liquidated and how many working days after the due date.
  liquidatedAt         DateTime?
  daysLate             Int?
  /// Overdue notice sent (cleared when the due date restarts).
  overdueNotifiedAt    DateTime?
  closedById           String?
  closedAt             DateTime?
  /// One-time exception used to submit this request while another advance was overdue.
  exceptionId          String?           @unique
  exception            FundsException?   @relation(fields: [exceptionId], references: [id])
  lines                CashAdvanceLine[]
  returns              CashReturn[]
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  @@index([requestedById, status])
}

model CashAdvanceLine {
  id               String             @id @default(cuid())
  advanceId        String
  advance          CashAdvance        @relation(fields: [advanceId], references: [id], onDelete: Cascade)
  /// Null for a general expense (e.g. transport).
  transactionId    String?
  transaction      LoanTransaction?   @relation(fields: [transactionId], references: [id])
  /// The expense kind's code (Settings > Expense kinds).
  kind             String
  kindRef          ExpenseKind        @relation(fields: [kind], references: [code], onUpdate: Cascade)
  /// Kind Other: what the expense is ("Courier"). Blank on old rows ("Other (not described)").
  otherDescription String             @default("")
  /// Where the amount came from: RULE (rule's suggested), PRESET (the kind's amount), OFFICE (LTO office transport), TYPED.
  amountSource     String             @default("TYPED")
  /// The starting value offered (rule, kind or office); kept so "Preset was ₱500" shows when it was changed.
  presetCents      Int?
  /// The kind's amount was Fixed when the line was made (the processor could not change it).
  locked           Boolean            @default(false)
  note             String             @default("")
  /// Typed reason when the amount is above the maximum per transaction.
  overMaxReason    String             @default("")
  /// The job's LTO office when the cash was requested (to show "Office changed from X to Y").
  ltoOfficeId      String?
  ltoOffice        LtoOffice?         @relation(fields: [ltoOfficeId], references: [id])
  requestedCents   Int
  approvedCents    Int?
  releasedCents    Int                @default(0)
  denied           Boolean            @default(false)
  topUps           CashAdvanceTopUp[]
  spends           AttemptSpend[]
  receipts         Receipt[]
  returns          CashReturn[]
  carryOvers       CarryOver[]
  createdAt        DateTime           @default(now())
}

model CashAdvanceTopUp {
  id              String          @id @default(cuid())
  lineId          String
  line            CashAdvanceLine @relation(fields: [lineId], references: [id], onDelete: Cascade)
  extraCents      Int
  reason          String
  status          TopUpStatus     @default(REQUESTED)
  approvedCents   Int?
  approverId      String?
  decidedAt       DateTime?
  decisionNote    String          @default("")
  releasedCents   Int             @default(0)
  releasedAt      DateTime?
  requestedById   String
  /// Follows the parent record's funds type; Finance may change it at release (with remarks).
  fundsTypeId     String          @default("fundstype_ca")
  fundsType       FundsType       @relation(fields: [fundsTypeId], references: [id])
  fundsTypeCode   String          @default("CA")
  fundsTypeName   String          @default("Cash advance")
  releaseRef      String          @default("")
  transferDate    String          @default("")
  accountProvider String          @default("")
  accountName     String          @default("")
  accountLast4    String          @default("")
  createdAt       DateTime        @default(now())
}

/// Funds types (Settings > Funds types): Cash advance (CA), Fund transfer (FT). Same funds flow for
/// every type; the switches only change what Finance enters at release and whether receipts are needed.
model FundsType {
  id                 String             @id @default(cuid())
  code               String             @unique
  name               String
  sortOrder          Int                @default(0)
  active             Boolean            @default(true)
  /// Seeded default not yet confirmed ("Proposed, to be confirmed with Finance"). Cleared when Admin saves the row.
  proposed           Boolean            @default(false)
  /// Release needs a transfer reference number and the transfer date.
  needsReference     Boolean            @default(false)
  /// Release needs the receiving account: bank or e-wallet, account name, last 4 digits.
  needsAccount       Boolean            @default(false)
  /// Must be liquidated with receipts (on for both by default).
  mustLiquidate      Boolean            @default(true)
  /// Liquidation due: this many working days after the last LTO pickup (D-017, D-044). 0 to 30.
  liquidationDueDays Int                @default(2)
  deactivatedAt      DateTime?
  deactivatedById    String?
  advances           CashAdvance[]
  topUps             CashAdvanceTopUp[]
  approvalBands      ApprovalBand[]
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
}

/// A day of work on a transaction (append-only).
model TransactionAttempt {
  id            String          @id @default(cuid())
  transactionId String
  transaction   LoanTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  dpUserId      String
  dpUser        User            @relation("DpAttempts", fields: [dpUserId], references: [id])
  date          String // YYYY-MM-DD (business time zone)
  result        AttemptResult
  reasonId      String?
  reason        ProblemReason?  @relation(fields: [reasonId], references: [id])
  note          String          @default("")
  restDecision  RestDecision    @default(NONE)
  simulated     Boolean         @default(false)
  /// The job stage that was current when it was logged (null before stages existed).
  jobStageId    String?
  jobStage      JobStage?       @relation(fields: [jobStageId], references: [id])
  correctsId    String?
  spends        AttemptSpend[]
  createdAt     DateTime        @default(now())

  @@index([transactionId, createdAt])
}

model AttemptSpend {
  id        String             @id @default(cuid())
  attemptId String
  attempt   TransactionAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  lineId    String
  line      CashAdvanceLine    @relation(fields: [lineId], references: [id])
  cents     Int
}

model Receipt {
  id           String          @id @default(cuid())
  lineId       String
  line         CashAdvanceLine @relation(fields: [lineId], references: [id])
  date         String // YYYY-MM-DD
  cents        Int
  number       String // receipt or OR number
  fileKey      String          @default("")
  fileName     String          @default("")
  mime         String          @default("")
  uploadedById String
  correctsId   String?
  createdAt    DateTime        @default(now())
}

/// Cash the DP returns; Finance confirms receipt.
model CashReturn {
  id            String           @id @default(cuid())
  advanceId     String
  advance       CashAdvance      @relation(fields: [advanceId], references: [id], onDelete: Cascade)
  lineId        String?
  line          CashAdvanceLine? @relation(fields: [lineId], references: [id])
  cents         Int
  date          String
  recordedById  String
  confirmedById String?
  confirmedAt   DateTime?
  /// CASH: cash given back to Finance. HANDOVER: the balance went to a second processor (Pasuyo) on a new advance.
  kind          CashReturnKind   @default(CASH)
  /// HANDOVER: the second processor's line that now holds the balance.
  toLineId      String?
  createdAt     DateTime         @default(now())
}

enum CashReturnKind {
  CASH
  HANDOVER
}

/// Pasuyo history (append-only): a job given to, or passed to, a second processor.
model PasuyoEvent {
  id           String       @id @default(cuid())
  assignmentId String
  assignment   DpAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  /// Who passed it (null: the LA chose a second processor at Send).
  fromUserId   String?
  fromLabel    String?
  toUserId     String
  toLabel      String
  byUserId     String?
  byLabel      String
  reason       String
  note         String       @default("")
  /// What happened to cash held for the job: NONE, RETURNED (cash return), HANDED (balance moved to the second processor).
  funds        String       @default("NONE")
  createdAt    DateTime     @default(now())

  @@index([assignmentId, createdAt])
}

/// A balance kept for the next attempt. Beyond the carry-over limit it needs approval.
model CarryOver {
  id           String          @id @default(cuid())
  lineId       String
  line         CashAdvanceLine @relation(fields: [lineId], references: [id])
  attemptId    String?
  cents        Int
  status       CarryOverStatus
  /// Business days since the first carry-over of this line, when decided.
  businessDays Int             @default(0)
  decidedById  String?
  decidedAt    DateTime?
  createdAt    DateTime        @default(now())
}

/// Finance lets a DP submit one new request while an advance is overdue (one-time).
model FundsException {
  id          String       @id @default(cuid())
  dpUserId    String
  grantedById String
  grantedAt   DateTime     @default(now())
  note        String       @default("")
  usedBy      CashAdvance?
}

/// Who approves an advance, by amount (Settings). The band with the highest "from" at or below the amount applies.
model ApprovalBand {
  id              String    @id @default(cuid())
  /// Each funds type has its own bands (Cash advance, Fund transfer); a type added later uses the Cash advance bands.
  fundsTypeId     String    @default("fundstype_ca")
  fundsType       FundsType @relation(fields: [fundsTypeId], references: [id])
  fromCents       Int
  roleId          String
  role            Role      @relation(fields: [roleId], references: [id])
  active          Boolean   @default(true)
  deactivatedAt   DateTime?
  deactivatedById String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  /// Several roles can share one band (the same type and amount): each of them approves it.
  @@unique([fundsTypeId, fromCents, roleId])
}

/// Reasons for a problem (also the result of an attempt that was not processed). Settings list.
model ProblemReason {
  id              String               @id @default(cuid())
  code            String               @unique
  name            String
  sortOrder       Int                  @default(0)
  active          Boolean              @default(true)
  deactivatedAt   DateTime?
  deactivatedById String?
  problems        Problem[]
  attempts        TransactionAttempt[]
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
}

/// A problem on a transaction: a red state with its own timer. The TAT clock never pauses for it.
model Problem {
  id                String          @id @default(cuid())
  loanId            String
  loan              Loan            @relation(fields: [loanId], references: [id], onDelete: Cascade)
  transactionId     String
  transaction       LoanTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  reasonId          String
  reason            ProblemReason   @relation(fields: [reasonId], references: [id])
  note              String          @default("")
  raisedById        String?
  raisedByLabel     String
  raisedAt          DateTime        @default(now())
  resolvedById      String?
  resolvedByLabel   String?
  resolvedAt        DateTime?
  resolutionNote    String          @default("")
  outsideControl    Boolean         @default(false)
  outsideMarkedById String?
  outsideMarkedAt   DateTime?
  simulated         Boolean         @default(false)
  /// The job stage that was current when it was raised.
  jobStageId        String?
  jobStage          JobStage?       @relation(fields: [jobStageId], references: [id])

  @@index([transactionId, resolvedAt])
}

/**
 * Reasons a transaction can be on hold (waiting on something that is not a fault). Settings list.
 */
model HoldReason {
  id              String    @id @default(cuid())
  code            String    @unique
  name            String
  sortOrder       Int       @default(0)
  active          Boolean   @default(true)
  /// Seeded default not yet confirmed with the team ("Proposed, to be confirmed with the team"). Cleared when Admin saves the row.
  proposed        Boolean   @default(false)
  /// "Pauses TAT" (D-032 Q-N7, D-041): while a hold with this reason is open, the TAT clock stops.
  pausesTat       Boolean   @default(false)
  deactivatedAt   DateTime?
  deactivatedById String?
  holds           Hold[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

/**
 * A transaction On hold: it waits on something that is not a fault (the borrower, another team, an
 * LTO appointment). Separate from Problem; both may be open at once (the problem wins for colour).
 * The TAT clock never pauses: a hold only changes the state and has its own timer. Several holds can
 * happen over time, but only one is open per transaction (unique index on open holds, see migration).
 * The row is written when the hold starts and closed (resumed*) when it ends; nothing else changes.
 */
model Hold {
  id               String          @id @default(cuid())
  loanId           String
  loan             Loan            @relation(fields: [loanId], references: [id], onDelete: Cascade)
  transactionId    String
  transaction      LoanTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  reasonId         String
  reason           HoldReason      @relation(fields: [reasonId], references: [id])
  /// A copy of the reason's name when the hold started: reports stay right if the name changes later.
  reasonName       String          @default("")
  note             String          @default("")
  /// Optional "expected to resume on" date, YYYY-MM-DD in Philippine time.
  expectedResumeOn String?
  raisedById       String?
  raisedBy         User?           @relation("HoldRaisedBy", fields: [raisedById], references: [id])
  raisedByLabel    String
  raisedAt         DateTime        @default(now())
  /// The hold owner: the only person who can resume it. Starts as the person who put it on hold;
  /// a supervisor or Admin (holds:transfer) can transfer it. Null for an old hold saved without one.
  ownerId          String?
  owner            User?           @relation("HoldOwner", fields: [ownerId], references: [id])
  ownerLabel       String?
  transfers        HoldTransfer[]
  resumedById      String?
  resumedBy        User?           @relation("HoldResumedBy", fields: [resumedById], references: [id])
  resumedByLabel   String?
  resumedAt        DateTime?
  resumeNote       String          @default("")
  simulated        Boolean         @default(false)
  /// The job stage that was current when it was put on hold.
  jobStageId       String?
  jobStage         JobStage?       @relation(fields: [jobStageId], references: [id])

  @@index([transactionId, resumedAt])
  @@index([loanId])
}

/**
 * A hold given to another owner (holds:transfer). Append-only: who it went from and to, who did it,
 * why and when. The hold's reason, remarks, start and "put on hold by" never change.
 */
model HoldTransfer {
  id        String   @id @default(cuid())
  holdId    String
  hold      Hold     @relation(fields: [holdId], references: [id], onDelete: Cascade)
  fromId    String?
  fromLabel String
  toId      String
  toLabel   String
  byId      String
  byLabel   String
  note      String
  at        DateTime @default(now())

  @@index([holdId])
}

/// A missing paper's state (Present is ChecklistCheck.checked with no missing state).
enum PaperMissingState {
  MISSING
  RECEIVED_LATE
}

/**
 * Why a paper is missing (Settings > Missing paper reasons). Remarks are always required as well.
 */
model MissingPaperReason {
  id              String           @id @default(cuid())
  code            String           @unique
  name            String
  sortOrder       Int              @default(0)
  active          Boolean          @default(true)
  deactivatedAt   DateTime?
  deactivatedById String?
  checks          ChecklistCheck[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

/**
 * The history of a missing paper, append-only (never updated or deleted): marked missing, reason and
 * remarks saved or edited (old and new text), marked present again (before sending only), received late.
 */
model PaperEvent {
  id         String         @id @default(cuid())
  checkId    String
  check      ChecklistCheck @relation(fields: [checkId], references: [id], onDelete: Cascade)
  loanId     String
  /// MARKED_MISSING, REMARKS_SAVED, REMARKS_EDITED, CLEARED, RECEIVED_LATE
  kind       String
  reasonName String?
  oldText    String?
  newText    String?
  receivedOn String?
  byId       String?
  byLabel    String
  at         DateTime       @default(now())

  @@index([checkId, at])
  @@index([loanId])
}

/**
 * Why a processor returns an accepted job to the LA (papers needed). Settings list.
 */
model ReturnReason {
  id              String         @id @default(cuid())
  code            String         @unique
  name            String
  sortOrder       Int            @default(0)
  active          Boolean        @default(true)
  deactivatedAt   DateTime?
  deactivatedById String?
  assignments     DpAssignment[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

// ---------------------------------------------------------------------------
// Processing stages (Settings) and job stages (per DP job)
// ---------------------------------------------------------------------------

/// What a stage is: the type's own work (OWN, in order), or a stage the system adds:
/// LTO drop off and LTO pickup (only when the type needs LTO processing), Check and verify (always last).
enum StageKind {
  OWN
  LTO_DROP
  LTO_PICKUP
  VERIFY
}

/// Settings > Processing stages: the ordered stages of one transaction type. Never deleted (Inactive).
model ProcessingStage {
  id              String          @id @default(cuid())
  typeId          String
  type            TransactionType @relation(fields: [typeId], references: [id])
  code            String
  name            String
  kind            StageKind       @default(OWN)
  /// Order among the type's own stages (system stages always follow them).
  sortOrder       Int             @default(0)
  /// Evidence fields, in order: [{ key, label, type: text | date | number | file | tick, required }].
  fields          Json            @default("[]")
  /// Optional target in business days (blank: no target). Informational chip only.
  targetDays      Int?
  active          Boolean         @default(true)
  deactivatedAt   DateTime?
  deactivatedById String?
  jobStages       JobStage[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@unique([typeId, code])
}

enum JobStageStatus {
  LATER
  STARTED
  DONE
}

/// One stage of one DP job: a snapshot of the setting (name, fields, target) with system start and
/// finish times and the evidence. Append-only in practice: a finished stage is never changed.
model JobStage {
  id              String               @id @default(cuid())
  assignmentId    String
  assignment      DpAssignment         @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  stageId         String?
  stage           ProcessingStage?     @relation(fields: [stageId], references: [id])
  code            String
  name            String
  kind            StageKind
  sortOrder       Int
  fields          Json                 @default("[]")
  targetDays      Int?
  status          JobStageStatus       @default(LATER)
  startedAt       DateTime?
  startedById     String?
  startedByLabel  String?
  finishedAt      DateTime?
  finishedById    String?
  finishedByLabel String?
  /// Evidence values by field key; Check and verify: { papers: { documentItemId: { at, by } }, note }.
  evidence        Json?
  /// Mapped from a job completed before stages existed (no start time was recorded).
  migrated        Boolean              @default(false)
  simulated       Boolean              @default(false)
  attempts        TransactionAttempt[]
  problems        Problem[]
  holds           Hold[]
  createdAt       DateTime             @default(now())

  @@unique([assignmentId, code])
  @@index([assignmentId, sortOrder])
  @@index([kind, finishedAt])
}

// ---------------------------------------------------------------------------
// LTO advisories ("maintenance report"): a warning about an LTO office. Never blocks anything.
// ---------------------------------------------------------------------------

enum LtoAdvisoryType {
  SYSTEM_DOWN
  OFFICE_CLOSED
  LONG_QUEUE
  OTHER
}

/// An LTO office problem filed by a processor (or by Operations). Active until resolved (with remarks).
model LtoAdvisory {
  id              String          @id @default(cuid())
  ltoOfficeId     String
  ltoOffice       LtoOffice       @relation(fields: [ltoOfficeId], references: [id])
  type            LtoAdvisoryType
  remarks         String
  /// When the problem started (default: when it was filed), PHT on screen.
  startedAt       DateTime
  filedById       String?
  filedBy         User?           @relation("AdvisoryFiledBy", fields: [filedById], references: [id])
  filedByLabel    String
  /// The job it was filed from (a DP job at an LTO stage), when it was.
  assignmentId    String?
  resolvedAt      DateTime?
  resolvedById    String?
  resolvedByLabel String?
  resolveRemarks  String          @default("")
  /// Last edit by a manager (type or remarks), if any.
  editedAt        DateTime?
  editedByLabel   String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([ltoOfficeId, resolvedAt])
  @@index([resolvedAt])
}

/// MyLoans calls in one clock hour (UTC "2026-11-12T06"), shared by every server instance, the cron
/// endpoint and the console script. Each call adds one with a single atomic statement.
model MyLoansCallHour {
  hour      String   @id
  calls     Int      @default(0)
  updatedAt DateTime @updatedAt
}

/// The MyLoans circuit breaker, shared by every instance: consecutive failures and, when open, until when.
model MyLoansBreaker {
  id        String    @id @default("myloans")
  failures  Int       @default(0)
  openUntil DateTime?
  updatedAt DateTime  @updatedAt
}

/// Piece 3 (D-019, D-039): one row per file view, download or log export. Append-only: the app never updates
/// or deletes these rows. Read on Audit, File access log ("View file access log").
model FileAccessLog {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation("FileAccessBy", fields: [userId], references: [id])
  /// RECEIPT, STAGE_EVIDENCE, LTO_PROOF, or FILE_ACCESS_LOG for a CSV export of this log.
  entityType String
  entityId   String
  loanId     String?
  pn         String?
  branchId   String?
  fileKey    String   @default("")
  fileName   String   @default("")
  /// VIEW, DOWNLOAD or EXPORT.
  action     String
  at         DateTime @default(now())
  ip         String?
  userAgent  String?

  @@index([at])
  @@index([userId, at])
  @@index([branchId, at])
  @@index([pn])
}

/// Piece 6 (D-047, D-048): the myloans MOCK's own data, used only while MYLOANS_MODE=mock on local or staging (never
/// production). One row per myloans transaction (ExternalLoanId); the mock builds the agreed API rows from it.
model MockMyLoansTxn {
  id                  Int       @id
  cin                 String?
  pnNo                String?
  statusId            Int       @default(12)
  isActive            Boolean   @default(true)
  /// The transaction code: 20 characters, plus "x<yyyymmddhhmmss>" once redone.
  code                String
  /// The newest updated_at of the loan's parts; created_at (a replacement's creation refreshes the old copy).
  updatedAt           DateTime
  createdAt           DateTime
  /// The live transaction that replaced this one (redo).
  replacedById        Int?
  /// A duplicate LOANS.CIN row: the loan comes back twice.
  duplicate           Boolean   @default(false)
  releaseDate         DateTime?
  amount              String?
  cifNo               String?
  firstName           String?
  middleName          String?
  lastName            String?
  suffix              String?
  loanId              String?
  loanTypeId          String?
  loanType            String?
  borrowerCompanyName String?
  productId           Int?
  branchId            Int?
  /// Where the row came from: "kit", "test", or a scenario name.
  source              String    @default("")

  @@index([pnNo])
  @@index([cin])
}

/// API 5 of the mock: products.
model MockMyLoansProduct {
  productId   Int     @id
  productCode String
  name        String
  active      Boolean @default(true)
}

/// API 4 of the mock: the organization (branch, area, division, company).
model MockMyLoansBranch {
  branchId     Int       @id
  branchCode   String?
  branchName   String
  areaId       Int?
  areaName     String?
  divisionId   Int?
  divisionName String?
  companyId    Int?
  companyName  String?
  isActive     Boolean   @default(true)
  updatedAt    DateTime?
}

/// D-049: myloans products (from API 5), with the optional manual classification that overrides the keywords.
/// Matched by myloans' ProductID, so a rename keeps the manual setting.
model Product {
  id                  String          @id @default(cuid())
  sourceProductId     Int             @unique
  code                String
  name                String
  active              Boolean         @default(true)
  /// Set by someone with "Manage product classification"; null: the keywords decide.
  classification      Classification?
  classificationNote  String          @default("")
  classifiedById      String?
  classifiedByLabel   String          @default("")
  classifiedAt        DateTime?
  /// When API 5 last sent it (the list is read whole each time).
  seenAt              DateTime        @default(now())
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  @@index([code])
}

/// D-050: a myloans copy (ExternalLoanId) a loan file was read from. The first is saved on open; piece 7 adds redo copies.
model LoanSourceIdentity {
  id             String   @id @default(cuid())
  loanId         String
  loan           Loan     @relation(fields: [loanId], references: [id], onDelete: Cascade)
  externalLoanId Int
  cin            String?
  pnNo           String?
  contentHash    String?
  feedState      String?
  firstSeenAt    DateTime @default(now())
  lastSeenAt     DateTime @default(now())

  @@unique([loanId, externalLoanId])
  @@index([externalLoanId])
}

/// D-050: every PN # search on Find loan (who, the PN typed, the outcome, when). Reports, PN searches.
model PnSearchLog {
  id               String   @id @default(cuid())
  userId           String
  userLabel        String
  /// The searcher's home branch at the time (the log is scoped by it, and by the loan's branch when known).
  searcherBranchId String?
  pn               String
  /// INVALID, FOUND_IN_DMS, NOT_FOUND, NOT_SELECTABLE, MULTIPLE, BUSY, UNAVAILABLE, REFUSED, PREVIEW, OPENED.
  outcome          String
  statusId         String?
  feedState        String?
  loanBranchId     String?
  at               DateTime @default(now())

  @@index([at])
  @@index([pn])
  @@index([loanBranchId, at])
  @@index([searcherBranchId, at])
}
